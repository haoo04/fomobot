NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=file:./data/market-sentinel.sqlite
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_ENCRYPTION_KEY_BASE64=
SESSION_SECRET=
LOG_LEVEL=info

# Telegram 可通过环境变量或控制台配置
TELEGRAM_BOT_TOKEN=
# M3 AI 审核配置
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REVIEW_ENABLED=false
AI_FAIL_POLICY=FAIL_CLOSED
AI_DAILY_BUDGET_USD=1
# M4 行情保留天数。K 线未配置的周期使用 365 天。
CANDLE_RETENTION_DAYS_BY_TIMEFRAME={}
OI_RETENTION_DAYS=180
